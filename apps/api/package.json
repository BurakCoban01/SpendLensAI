{
  "name": "@spendlens/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/run-with-root-env.mjs apps/api tsx watch src/main.ts",
    "dev:worker": "node ../../scripts/run-with-root-env.mjs apps/api tsx src/worker.ts",
    "dev:event-consumer": "node ../../scripts/run-with-root-env.mjs apps/api tsx src/event-consumer.ts",
    "dev:event-drainer": "node ../../scripts/run-with-root-env.mjs apps/api tsx src/event-drainer.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node ../../scripts/run-with-root-env.mjs apps/api node dist/main.js",
    "start:worker": "node ../../scripts/run-with-root-env.mjs apps/api node dist/worker.js",
    "start:event-consumer": "node ../../scripts/run-with-root-env.mjs apps/api node dist/event-consumer.js",
    "start:event-drainer": "node ../../scripts/run-with-root-env.mjs apps/api node dist/event-drainer.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --pool=forks --hookTimeout=60000 --testTimeout=60000",
    "test:unit": "vitest run --pool=forks --hookTimeout=60000 --testTimeout=60000"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.3.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^4.0.0",
    "@prisma/client": "^5.14.0",
    "@spendlens/shared": "workspace:*",
    "csv-parse": "^6.2.1",
    "fastify": "^4.27.0",
    "ioredis": "^5.10.1",
    "kafkajs": "^2.2.4",
    "minio": "^8.0.7",
    "pdfkit": "^0.18.0",
    "pino": "^9.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.10.2",
    "vitest": "^1.6.0"
  }
}
