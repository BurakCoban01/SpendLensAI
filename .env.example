# Copy to .env for local development. Do not commit real secrets.
NODE_ENV=development
LOG_LEVEL=info

POSTGRES_USER=spendlens
POSTGRES_PASSWORD=spendlens_local_password
POSTGRES_DB=spendlens
DATABASE_URL=postgresql://spendlens:spendlens_local_password@localhost:15433/spendlens?schema=public

POSTGRES_PORT=15433
REDIS_PORT=16380
KAFKA_PORT=19092
REDPANDA_ADMIN_PORT=19644
MINIO_API_PORT=19002
MINIO_CONSOLE_PORT=19003
PROMETHEUS_HOST_PORT=19090
GRAFANA_HOST_PORT=13001

REDIS_URL=redis://localhost:16380
KAFKA_BROKERS=localhost:19092
# Optional comma-separated groups for live Kafka consumer lag metrics on /metrics.
KAFKA_LAG_CONSUMER_GROUPS=spendlens-workers
EVENT_CONSUMER_CLIENT_ID=spendlens-event-consumer
EVENT_CONSUMER_GROUP_ID=spendlens-event-consumers
EVENT_CONSUMER_NAME=local-event-consumer
EVENT_CONSUMER_TOPICS=

MINIO_ROOT_USER=spendlens
MINIO_ROOT_PASSWORD=spendlens_local_minio_password
MINIO_ENDPOINT=http://localhost:19002
MINIO_BUCKET_DOCUMENTS=spendlens-documents
MINIO_BUCKET_ARTIFACTS=spendlens-artifacts
DOCUMENT_MAX_UPLOAD_BYTES=26214400
TENANT_STORAGE_SOFT_LIMIT_BYTES=536870912

API_PORT=18621
SPENDLENS_USE_MEMORY_ADAPTERS=false
SPENDLENS_SKIP_DEV_DB_SYNC=false
WEB_PORT=18620
OCR_SERVICE_PORT=18622
OCR_SERVICE_URL=http://localhost:18622
CUSTOM_OCR_ALLOW_UNREGISTERED_CHECKPOINT=false
NEXT_PUBLIC_API_BASE_URL=http://localhost:18621
CORS_ALLOWED_ORIGINS=http://localhost:18620,http://127.0.0.1:18620
RATE_LIMIT_MAX=300
RATE_LIMIT_TIME_WINDOW=1 minute
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=spendlens-local-admin

# Optional external LLM assistance. Disabled by default; never required for local OCR/expense flow.
LLM_ENABLED=false
LLM_PROVIDER=disabled
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
LLM_STORE_RAW_INPUTS=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_THINKING_MODE=high
ZAI_API_KEY=
ZAI_MODEL=glm-5.1
ZAI_THINKING_ENABLED=true

JWT_ACCESS_SECRET=replace_with_local_access_secret
JWT_REFRESH_SECRET=replace_with_local_refresh_secret
API_KEY_PEPPER=replace_with_local_api_key_pepper
WEBHOOK_SECRET_ENCRYPTION_KEY=replace_with_local_webhook_secret_encryption_key
SESSION_COOKIE_SECRET=replace_with_local_cookie_secret

TESSERACT_LANGS=tur+eng
CUSTOM_OCR_ARTIFACT_DIR=./artifacts/models
CUSTOM_OCR_DEFAULT_CHECKPOINT=artifacts/models/custom-crnn-project-real-crops-finetune-v5/model.pt
CUSTOM_OCR_NUMERIC_CHAR_CHECKPOINT=artifacts/models/local-full-20260620-ocr/numeric-char-cnn-v1/char-cnn.pt
CUSTOM_OCR_CHARACTER_CHECKPOINT=artifacts/models/custom-char-cnn-project-real-v1/char-cnn.pt
CUSTOM_OCR_CRNN_CHALLENGER_CHECKPOINT=artifacts/models/custom-crnn-mixed-regression-replay-longline-specialist-20260710/model.pt
CUSTOM_OCR_ROUTER_CHECKPOINT=artifacts/models/custom-ocr-pairwise-router-sroie-v1-20260711/router.json
CUSTOM_OCR_CRNN_CHALLENGER_MODE=validated

# Dedicated local worker process. Use either WORKER_ACCESS_TOKEN or the login trio below.
# The worker account must have admin.jobs.manage for the tenant it drains.
WORKER_API_BASE_URL=http://localhost:18621
WORKER_ID=local-dedicated-worker
WORKER_QUEUE=
WORKER_INTERVAL_MS=1000
WORKER_MAX_JOBS_PER_TICK=5
WORKER_ACCESS_TOKEN=
WORKER_TENANT_SLUG=
WORKER_EMAIL=
WORKER_PASSWORD=

# Autonomous local event outbox drainer. Use either EVENT_DRAINER_ACCESS_TOKEN
# or the login trio below. The account must have admin.events.publish.
EVENT_DRAINER_API_BASE_URL=http://localhost:18621
EVENT_DRAINER_ID=local-event-drainer
EVENT_DRAINER_INTERVAL_MS=5000
EVENT_DRAINER_LIMIT=25
EVENT_DRAINER_INCLUDE_FAILED=false
EVENT_DRAINER_ACCESS_TOKEN=
EVENT_DRAINER_TENANT_SLUG=
EVENT_DRAINER_EMAIL=
EVENT_DRAINER_PASSWORD=
